{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/schemas/r0/evidence_record_v1.schema.json",
  "title": "Sentinel R0 Evidence Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "record_id",
    "matrix_row_id",
    "phase",
    "baseline_commit",
    "candidate_commit",
    "comparison_key",
    "probe",
    "environment_manifest",
    "execution",
    "outcome",
    "test_references",
    "review"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "kind": {"const": "r0_evidence_record"},
    "record_id": {"type": "string", "minLength": 1},
    "matrix_row_id": {
      "enum": [
        "R0-EVIDENCE-OUTAGE",
        "R0-REPORT-CONTAINMENT",
        "R0-ARCHIVE-CONTAINMENT",
        "R0-DATA-RELEASE-TRUST",
        "R0-AUTHORIZATION-LIMITS",
        "R0-SIGNER-ISOLATION",
        "R0-PROOF-IDENTITY",
        "R0-TRANSACTION-TRUTH"
      ]
    },
    "phase": {"enum": ["before", "after"]},
    "baseline_commit": {"$ref": "#/$defs/git_sha"},
    "candidate_commit": {
      "oneOf": [{"$ref": "#/$defs/git_sha"}, {"type": "null"}]
    },
    "comparison_key": {"$ref": "#/$defs/sha256"},
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "contract_version",
        "argv_template",
        "resolved_argv",
        "cwd"
      ],
      "properties": {
        "probe_id": {"type": "string", "minLength": 1},
        "contract_version": {"const": "1"},
        "argv_template": {"$ref": "#/$defs/nonempty_string_array"},
        "resolved_argv": {"$ref": "#/$defs/nonempty_string_array"},
        "cwd": {"type": "string", "minLength": 1}
      }
    },
    "environment_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "environment_contract"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "environment_contract": {"type": "string", "minLength": 1},
        "comparison_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "finished_at",
        "exit_code",
        "stdout_sha256",
        "stderr_sha256",
        "stdout",
        "stderr"
      ],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "exit_code": {"type": "integer"},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "invariant_passed", "assertions"],
      "properties": {
        "status": {"enum": ["pass", "fail", "blocked", "unavailable"]},
        "invariant_passed": {"type": "boolean"},
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "passed", "detail"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "passed": {"type": "boolean"},
              "detail": {"type": "string"}
            }
          }
        }
      }
    },
    "test_references": {"$ref": "#/$defs/nonempty_string_array"},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "decided_at"],
      "properties": {
        "status": {"enum": ["pending", "accepted", "rejected"]},
        "reviewer": {"type": ["string", "null"]},
        "decided_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"phase": {"const": "before"}}},
      "then": {"properties": {"candidate_commit": {"type": "null"}}}
    },
    {
      "if": {"properties": {"phase": {"const": "after"}}},
      "then": {"properties": {"candidate_commit": {"$ref": "#/$defs/git_sha"}}}
    },
    {
      "if": {
        "properties": {"review": {"properties": {"status": {"const": "accepted"}}}}
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "reviewer": {"type": "string", "minLength": 1},
              "decided_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonempty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}

  "negative_authority": {
    "first_baseline_blanket_negative_sources": [],
    "confirmed_negative_rule": "target_value=0 requires direct class-specific evidence that meaningfully assessed absence; no current parser/default/all-zero mechanism qualifies",
    "weak_negative_training": "NOT_AUTHORIZED_IN_V1"
  },
  "aggregation": {
    "preserve_all_source_claims": true,
    "rules": [
      "confirmed_positive_without_confirmed_negative -> CONFIRMED_POSITIVE",
      "confirmed_negative_without_confirmed_positive -> CONFIRMED_NEGATIVE",
      "confirmed_positive_and_confirmed_negative -> CONFLICTING_EVIDENCE",
      "weak_positive_without_confirmed_contrary_outcome may produce POSITIVE/WEAK training signal but outcome remains UNKNOWN or NOT_REVIEWED",
      "weak claim never overrides confirmed contrary outcome",
      "tool/source vote count alone never establishes outcome",
      "no evidence or only unsupported/dropped/absent claims -> UNKNOWN or NOT_REVIEWED, target null"
    ],
    "positive_precedence_over_binary_zero": "REMOVED",
    "global_nonvulnerable_synthesis": "FORBIDDEN"
  },
  "export_contract": {
    "historical_export_schema": "v1_immutable",
    "vnext_export_schema": "v2",
    "canonical_semantic_artifact": "label_states.parquet_long_contract_class",
    "phase6_partition_artifact": "partitions.parquet_or_equivalent_separate_role_manifest",
    "ml_projection": "derived_per_contract_10_class_projection_with_target_strength_and_masks",
    "required_ml_projection_fields_per_class": [
      "target_value_nullable",
      "training_strength",
      "loss_eligible",
      "outcome_metric_eligible",
      "outcome_state",
      "policy_decision_id"
    ],
    "legacy_reader_rule": "v1 and v2 readers must be explicit; no silent fallback from missing v2 fields to historical zero semantics",
    "graph_schema_rule": "graph FEATURE_SCHEMA_VERSION remains v9 unless separately authorized"
  },
  "phase_boundaries": {
    "phase5": "semantic policy and schema only",
    "phase6": "assign leakage-safe dataset roles/partitions and freeze/declare acceptance support",
    "phase7": "implement data pipeline/export exactly from policy+partitions",
    "phase8": "adapt existing trainer for masks/strong-weak handling and choose explicit numeric weak loss weight",
    "phase9": "evaluation/calibration/threshold policy only on authorized independent roles"
  },

{
  "schema": "sentinel-data-vnext-policy-v1",
  "policy_version": "data-vnext-policy-v1",
  "status": "PROPOSED_FOR_G5_VALIDATION",
  "class_vocabulary": {
    "feature_schema_version": "v9",
    "locked": true,
    "classes": [
      "CallToUnknown",
      "DenialOfService",
      "ExternalBug",
      "GasException",
      "IntegerUO",
      "MishandledException",
      "Reentrancy",
      "Timestamp",
      "TransactionOrderDependence",
      "UnusedReturn"
    ],
    "rule": "No add/remove/reorder in R4. Semantic policy is versioned separately from positional model output."
  },
  "state_model": {
    "unit_of_truth": "contract_id_x_class_index",
    "outcome_states": [
      "CONFIRMED_POSITIVE",
      "CONFIRMED_NEGATIVE",
      "UNKNOWN",
      "NOT_APPLICABLE",
      "CONFLICTING_EVIDENCE",
      "NOT_REVIEWED",
      "INVALID_RECORD"
    ],
    "historical_states": [
      "HISTORICAL_POSITIVE",
      "HISTORICAL_ZERO",
      "HISTORICAL_MISSING"
    ],
    "source_claim_states": [
      "POSITIVE",
      "EXPLICIT_ZERO",
      "UNKNOWN",
      "UNSUPPORTED",
      "DROPPED_CATEGORY",
      "OUT_OF_TAXONOMY",
      "UNAVAILABLE",
      "NO_ASSERTION"
    ],
    "training_signals": ["POSITIVE", "NEGATIVE", "NONE"],
    "training_strengths": ["STRONG", "WEAK", "NONE"],
    "invariants": [
      "historical_zero_never_implies_confirmed_negative",
      "source_absence_never_implies_negative",
      "unsupported_class_never_implies_negative",
      "dropped_or_out_of_taxonomy_category_never_implies_nonvulnerable",
      "weak_training_signal_does_not_confirm_outcome",
      "target_zero_requires_confirmed_negative_evidence",
      "no_global_nonvulnerable_label_is_synthesized"
    ]
  },
  "record_contract": {
    "required_fields_per_contract_class": [
      "contract_id",
      "class_index",
      "class_name",
      "historical_state",
      "source_claims",
      "outcome_state",
      "target_value",
      "training_signal",
      "training_strength",
      "loss_eligible",
      "outcome_metric_eligible",
      "role_eligibility",
      "policy_decision_id",
      "evidence_ids",
      "limitations"
    ],
    "target_value": {
      "type": "nullable_int8",
      "allowed": [0, 1, null],
      "rules": {
        "1": "Allowed for CONFIRMED_POSITIVE/STRONG or explicitly authorized WEAK positive training signal.",
        "0": "Allowed only when outcome_state is CONFIRMED_NEGATIVE.",
        "null": "Required when no authorized training target exists."
      }
    },
    "loss_eligible": "true only when target_value is non-null and training_strength is STRONG or WEAK",
    "outcome_metric_eligible": "never true for WEAK signals; final metric role also depends on Phase-6 partition assignment",
    "numeric_training_weight": "NOT_DATA_SEMANTICS; Phase 8 must map STRONG/WEAK to numeric optimizer weights in explicit checkpoint-bound config"
  },
  "class_supervision": {
